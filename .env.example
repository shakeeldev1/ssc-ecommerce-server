# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,https://ssc-e-commerce.vercel.app

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ssc_db
DB_SYNCHRONIZE=false
DB_LOGGING=true
# SSL is auto-enabled for any DB_HOST other than localhost/127.0.0.1 (e.g.
# Neon, RDS). Set explicitly to force either way.
# DB_SSL=true

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (image/file uploads) — leave blank until credentials are supplied;
# uploads will fail with a clear error until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bootstraps one Super Admin account on startup if set and the account
# doesn't already exist. Leave blank in shared/production environments.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# External Student Smart Card system (see EXTERNAL_INTEGRATION_SPEC.md).
# Base URL must include that system's own "/api/v1" prefix. Leave blank to
# use the built-in MockStudentSyncProvider instead.
EXTERNAL_STUDENT_SYSTEM_BASE_URL=
EXTERNAL_STUDENT_SYSTEM_API_KEY=

# How many days a normally-earned commission is held before release, to
# protect against having to reverse an already-paid-out commission if the
# order is returned within the window. Defaults to 7 if unset.
COMMISSION_HOLD_WINDOW_DAYS=7

# Tax rates (percent), applied on the net goods value at checkout and itemized
# on the invoice. All default to 0 (tax off) — set real rates when the client
# confirms them. Typical Pakistan values shown as a guide, not defaults:
#   GST 17, PST provincial (e.g. Punjab 16 on services), WHT where applicable.
TAX_GST_RATE=0
TAX_PST_RATE=0
TAX_WHT_RATE=0
